# =====================================================================
# Variables de entorno de Curino Web
# Copia este archivo como .env.local (no se commitea) y rellena valores.
# En producción se configuran desde el dashboard de Vercel.
# =====================================================================

# --- Supabase (proyecto principal) ---
SUPABASE_URL=https://fsfminynxnmhsagqenat.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role / secret key — sólo backend (webhooks, /api/admin/*).
# Nunca exponer al cliente.
SUPABASE_SECRET_KEY=

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Anthropic (generador de artículos IA) ---
# Necesaria para /api/admin/generate-article. Modelo por defecto: claude-opus-4-7.
ANTHROPIC_API_KEY=sk-ant-...

# --- Google Maps (autocomplete checkout) ---
GOOGLE_MAPS_API_KEY=

# --- Clases (landing /clases) ---
# Secreto compartido entre pg_cron (Postgres) y la Edge Function
# notify-class-reminder. Debe coincidir con la GUC
# `app.settings.cron_secret` del proyecto Supabase.
# Se define SÓLO en Supabase Edge Secrets (dashboard), no en Vercel.
CRON_SECRET=
